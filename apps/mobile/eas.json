      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://amara-api-4b5v.onrender.com"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://CAMBIAR-por-la-url-de-la-api.ejemplo.mx"
      }
    }
  },
  "submit": { "production": {} }
}
